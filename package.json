{
  "name": "job-applier",
  "version": "0.1.0",
  "description": "Applies to jobs from Dossier automatically",
  "scripts": {
    "setup": "tsx src/cli.ts setup",
    "run": "tsx src/cli.ts run",
    "dry-run": "tsx src/cli.ts run --dry-run",
    "try": "tsx src/cli.ts try",
    "report": "tsx src/cli.ts report",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx test/smoke.ts",
    "retry": "tsx src/cli.ts retry",
    "pending": "tsx src/cli.ts pending",
    "sync": "tsx src/cli.ts sync",
    "check-private": "tsx scripts/check-private.ts --all",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "google-auth-library": "^11.3.3",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
